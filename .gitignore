# ── Variables de entorno ──────────────────────────────────────────────────────
.env
.env.*
!.env.example

# ── Python ────────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.pyo
*.pyd
.Python
*.so

# ── Entornos virtuales ────────────────────────────────────────────────────────
venv/
.venv/
env/
.env/
ENV/

# ── Pytest y cobertura ────────────────────────────────────────────────────────
.pytest_cache/
.coverage
htmlcov/
coverage.xml
*.cover

# ── Mypy ──────────────────────────────────────────────────────────────────────
.mypy_cache/
.dmypy.json
dmypy.json

# ── Alembic ───────────────────────────────────────────────────────────────────
# No ignorar las migraciones, solo los archivos temporales
*.pyc

# ── Logs ──────────────────────────────────────────────────────────────────────
*.log
logs/
*.log.*

# ── Docker ────────────────────────────────────────────────────────────────────
docker-compose.override.yml

# ── Node / Next.js (frontend) ─────────────────────────────────────────────────
node_modules/
.next/
out/
dist/
*.tsbuildinfo
.npm
.yarn

# ── IDEs y editores ───────────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*.sublime-project
*.sublime-workspace
.DS_Store
Thumbs.db

# ── Archivos temporales del sistema ───────────────────────────────────────────
*.tmp
*.temp
*.bak
*.orig

# ── Certificados SSL ──────────────────────────────────────────────────────────
*.pem
*.key
*.crt
# Certificados de Nginx: se ignora la carpeta completa, no solo por extension
infrastructure/nginx/ssl/
*.csr

# ── Backups ───────────────────────────────────────────────────────────────────
*.sql
*.dump
*.backup*:Zone.Identifier

# Security — never commit
security/

# Etiquetas de descarga de Windows
*:Zone.Identifier

# Auditoria de seguridad: el script y el README si van en git; los informes y acuses no (son sensibles)
!security/
security/*
!security/informes-periodicos/
security/informes-periodicos/*
!security/informes-periodicos/auditoria.sh
!security/informes-periodicos/README.md
